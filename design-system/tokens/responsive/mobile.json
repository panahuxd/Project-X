{
  "$description": "Layer 4 - responsive, mode Mobile. Mobile below 1024 px (phones and tablets), Desktop from 1024 px (DS-11). Code: tokens.css media query. Figma: set this mode explicitly on every screen frame (360 = Mobile, 1440 = Desktop); templates come with it.",
  "type": {
    "$type": "dimension",
    "display": {
      "size": {
        "$value": "{font.size.32}"
      },
      "line-height": {
        "$value": "{font.line-height.48}"
      }
    },
    "heading-1": {
      "size": {
        "$value": "{font.size.24}"
      },
      "line-height": {
        "$value": "{font.line-height.36}"
      }
    },
    "heading-2": {
      "size": {
        "$value": "{font.size.20}"
      },
      "line-height": {
        "$value": "{font.line-height.32}"
      }
    },
    "heading-3": {
      "size": {
        "$value": "{font.size.18}"
      },
      "line-height": {
        "$value": "{font.line-height.30}"
      }
    },
    "heading-4": {
      "size": {
        "$value": "{font.size.16}"
      },
      "line-height": {
        "$value": "{font.line-height.28}"
      }
    },
    "$extensions": {
      "dkb.figma": {
        "scopes": [],
        "hidden": true
      }
    }
  },
  "control": {
    "$type": "dimension",
    "$description": "Heights of buttons, inputs and selects. Mobile is larger for touch (40 px minimum for default).",
    "height-sm": {
      "$value": "{size.36}"
    },
    "height-md": {
      "$value": "{size.40}"
    },
    "height-lg": {
      "$value": "{size.48}"
    },
    "$extensions": {
      "dkb.figma": {
        "scopes": [
          "WIDTH_HEIGHT"
        ],
        "hidden": false
      }
    }
  },
  "layout": {
    "$type": "dimension",
    "page-margin": {
      "$value": "{space.16}",
      "$description": "Side padding of the page"
    },
    "gutter": {
      "$value": "{space.16}",
      "$description": "Gap between columns and cards"
    },
    "section-gap": {
      "$value": "{space.32}",
      "$description": "Vertical gap between page sections"
    },
    "content-max-width": {
      "$value": "{size.1312}"
    },
    "$extensions": {
      "dkb.figma": {
        "scopes": [
          "GAP",
          "WIDTH_HEIGHT"
        ],
        "hidden": false
      }
    }
  }
}
