{
  "$description": "Layer 3 - semantic, mode Light. Components and screens use these, grouped by the property they paint. Values alias brand or primitives. A Dark mode will reuse the same names.",
  "bg": {
    "$type": "color",
    "$extensions": {
      "dkb.figma": {
        "scopes": [
          "FRAME_FILL",
          "SHAPE_FILL"
        ],
        "hidden": false
      }
    },
    "default": {
      "$value": "{color.white}",
      "$description": "Page background"
    },
    "subtle": {
      "$value": "{color.neutral.50}",
      "$description": "Section bands, areas behind cards"
    },
    "surface": {
      "$value": "{color.white}",
      "$description": "Cards, popovers, dropdowns, sheets"
    },
    "muted": {
      "$value": "{color.neutral.100}",
      "$description": "Quiet fills: secondary buttons, tags, chips, table header, skeleton, read-only fields; selected rows and current nav item (DS-43)"
    },
    "muted-hover": {
      "$value": "{color.neutral.200}"
    },
    "hover": {
      "$value": "{color.neutral.100}",
      "$description": "Hover on ghost buttons, menu items, list and table rows"
    },
    "disabled": {
      "$value": "{color.neutral.100}"
    },
    "inverse": {
      "$value": "{color.neutral.900}",
      "$description": "Tooltips, dark toasts"
    },
    "overlay": {
      "$value": "{color.black-alpha.50}",
      "$description": "Backdrop behind dialogs and sheets"
    },
    "primary": {
      "$value": "{brand.800}",
      "$description": "Primary buttons, selected controls (checkbox, radio, switch), active step"
    },
    "primary-hover": {
      "$value": "{brand.700}"
    },
    "primary-active": {
      "$value": "{brand.900}"
    },
    "primary-subtle": {
      "$value": "{brand.50}",
      "$description": "Brand tint: selected cards and options the user chooses (with border.primary), highlighted bands. Selected rows and the current page use bg.muted (DS-43)"
    },
    "primary-subtle-hover": {
      "$value": "{brand.100}"
    },
    "destructive": {
      "$value": "{color.red.600}",
      "$description": "Destructive button, solid error badge"
    },
    "destructive-hover": {
      "$value": "{color.red.700}"
    },
    "destructive-subtle": {
      "$value": "{color.red.50}",
      "$description": "Error alert, soft error badge"
    },
    "success": {
      "$value": "{color.green.700}"
    },
    "success-subtle": {
      "$value": "{color.green.50}"
    },
    "warning": {
      "$value": "{color.amber.500}"
    },
    "warning-subtle": {
      "$value": "{color.amber.50}"
    },
    "info": {
      "$value": "{color.blue.600}"
    },
    "info-subtle": {
      "$value": "{color.blue.50}"
    }
  },
  "text": {
    "$type": "color",
    "$extensions": {
      "dkb.figma": {
        "scopes": [
          "TEXT_FILL",
          "SHAPE_FILL",
          "STROKE_COLOR"
        ],
        "hidden": false
      }
    },
    "$description": "Also used for icons.",
    "default": {
      "$value": "{color.neutral.900}",
      "$description": "Main text and icons"
    },
    "muted": {
      "$value": "{color.neutral.600}",
      "$description": "Secondary text: hints, captions, meta, placeholders"
    },
    "disabled": {
      "$value": "{color.neutral.400}",
      "$description": "Inactive content only: an item that cannot be used, e.g. the name of an unavailable product. WCAG exempts inactive UI only, not the token: readable secondary text uses text.muted. Disabled controls use opacity.disabled (DS-28)"
    },
    "inverse": {
      "$value": "{color.white}",
      "$description": "On bg.inverse"
    },
    "primary": {
      "$value": "{brand.800}",
      "$description": "Brand-coloured text and icons; text on bg.primary-subtle"
    },
    "link": {
      "$value": "{brand.700}"
    },
    "on-primary": {
      "$value": "{color.white}",
      "$description": "On bg.primary"
    },
    "destructive": {
      "$value": "{color.red.700}",
      "$description": "Error text, text on bg.destructive-subtle"
    },
    "on-destructive": {
      "$value": "{color.white}"
    },
    "success": {
      "$value": "{color.green.800}"
    },
    "on-success": {
      "$value": "{color.white}"
    },
    "warning": {
      "$value": "{color.amber.800}"
    },
    "on-warning": {
      "$value": "{color.amber.950}",
      "$description": "Dark text: white fails on amber"
    },
    "info": {
      "$value": "{color.blue.700}"
    },
    "on-info": {
      "$value": "{color.white}"
    }
  },
  "border": {
    "$type": "color",
    "$extensions": {
      "dkb.figma": {
        "scopes": [
          "STROKE_COLOR"
        ],
        "hidden": false
      }
    },
    "default": {
      "$value": "{color.neutral.200}",
      "$description": "Dividers, card and table borders"
    },
    "strong": {
      "$value": "{color.neutral.300}"
    },
    "input": {
      "$value": "{color.neutral.300}",
      "$description": "Text field border (input, textarea, select). 1.48:1, so never the only cue (DS-20): the field also needs a visible label, a bg.muted fill or its own context. Where none of these exists, use border.control (DS-39)"
    },
    "control": {
      "$value": "{color.neutral.500}",
      "$description": "Boundary that must meet 3:1: checkbox, radio, switch track (DS-21); and text fields that have no visible label or other cue, e.g. a header search field, inline edit in a table, a quantity stepper (override the stroke of the instance, DS-39)"
    },
    "focus": {
      "$value": "{color.neutral.400}",
      "$description": "Border of a focused control (shadcn --ring). Paired with ring.default around it"
    },
    "primary": {
      "$value": "{brand.800}",
      "$description": "Selected card or option outline"
    },
    "primary-subtle": {
      "$value": "{brand.200}"
    },
    "destructive": {
      "$value": "{color.red.600}",
      "$description": "Field in error"
    },
    "destructive-subtle": {
      "$value": "{color.red.200}",
      "$description": "Error alert border"
    },
    "success-subtle": {
      "$value": "{color.green.200}"
    },
    "warning-subtle": {
      "$value": "{color.amber.200}"
    },
    "info-subtle": {
      "$value": "{color.blue.200}"
    }
  },
  "chart": {
    "$type": "color",
    "$description": "Categorical chart series, used in this fixed order (DS-34). Validated for colour-blind separation and 3:1 on white. Never for status; never for text.",
    "$extensions": {
      "dkb.figma": {
        "scopes": [
          "FRAME_FILL",
          "SHAPE_FILL",
          "STROKE_COLOR"
        ],
        "hidden": false
      }
    },
    "1": {
      "$value": "{brand.600}",
      "$description": "Series 1: brand (B2R navy 600, B2E violet 600)"
    },
    "2": {
      "$value": "{color.teal.600}",
      "$description": "Series 2"
    },
    "3": {
      "$value": "{color.orange.600}",
      "$description": "Series 3"
    },
    "4": {
      "$value": "{color.pink.600}",
      "$description": "Series 4"
    },
    "5": {
      "$value": "{color.lime.600}",
      "$description": "Series 5"
    }
  },
  "campaign": {
    "$type": "color",
    "$description": "Dark campaign surface for event and campaign landings (DS-48). Use only inside a campaign section, never in product UI. Same values in B2R and B2E for now.",
    "bg": {
      "$value": "{color.midnight.950}",
      "$description": "Campaign page and section background",
      "$extensions": {
        "dkb.figma": {
          "scopes": [
            "FRAME_FILL",
            "SHAPE_FILL"
          ],
          "hidden": false
        }
      }
    },
    "bg-raised": {
      "$value": "{color.midnight.900}",
      "$description": "Raised areas on the campaign surface: input fill, info panels",
      "$extensions": {
        "dkb.figma": {
          "scopes": [
            "FRAME_FILL",
            "SHAPE_FILL"
          ],
          "hidden": false
        }
      }
    },
    "text": {
      "$value": "{color.white}",
      "$description": "Titles and main text on the campaign surface",
      "$extensions": {
        "dkb.figma": {
          "scopes": [
            "TEXT_FILL",
            "SHAPE_FILL",
            "STROKE_COLOR"
          ],
          "hidden": false
        }
      }
    },
    "text-muted": {
      "$value": "{color.navy.200}",
      "$description": "Body and secondary text on the campaign surface",
      "$extensions": {
        "dkb.figma": {
          "scopes": [
            "TEXT_FILL",
            "SHAPE_FILL",
            "STROKE_COLOR"
          ],
          "hidden": false
        }
      }
    },
    "text-subtle": {
      "$value": "{color.navy.300}",
      "$description": "Meta, hints and placeholders on the campaign surface",
      "$extensions": {
        "dkb.figma": {
          "scopes": [
            "TEXT_FILL",
            "SHAPE_FILL",
            "STROKE_COLOR"
          ],
          "hidden": false
        }
      }
    },
    "text-error": {
      "$value": "{color.red.300}",
      "$description": "Error text under a field on the campaign surface (text.destructive fails on navy)",
      "$extensions": {
        "dkb.figma": {
          "scopes": [
            "TEXT_FILL",
            "SHAPE_FILL",
            "STROKE_COLOR"
          ],
          "hidden": false
        }
      }
    },
    "text-success": {
      "$value": "{color.green.300}",
      "$description": "Success text and icons on the campaign surface",
      "$extensions": {
        "dkb.figma": {
          "scopes": [
            "TEXT_FILL",
            "SHAPE_FILL",
            "STROKE_COLOR"
          ],
          "hidden": false
        }
      }
    },
    "border": {
      "$value": "{color.navy.700}",
      "$description": "Dividers and section rules on the campaign surface (decorative)",
      "$extensions": {
        "dkb.figma": {
          "scopes": [
            "STROKE_COLOR"
          ],
          "hidden": false
        }
      }
    },
    "border-control": {
      "$value": "{color.navy.500}",
      "$description": "Input boundary on the campaign surface (3:1, DS-39)",
      "$extensions": {
        "dkb.figma": {
          "scopes": [
            "STROKE_COLOR"
          ],
          "hidden": false
        }
      }
    },
    "border-error": {
      "$value": "{color.red.400}",
      "$description": "Field in error on the campaign surface",
      "$extensions": {
        "dkb.figma": {
          "scopes": [
            "STROKE_COLOR"
          ],
          "hidden": false
        }
      }
    },
    "cta": {
      "$value": "{color.electric.600}",
      "$description": "Main campaign button fill",
      "$extensions": {
        "dkb.figma": {
          "scopes": [
            "FRAME_FILL",
            "SHAPE_FILL"
          ],
          "hidden": false
        }
      }
    },
    "cta-hover": {
      "$value": "{color.electric.500}",
      "$description": "Main campaign button, hover (one step lighter on a dark surface)",
      "$extensions": {
        "dkb.figma": {
          "scopes": [
            "FRAME_FILL",
            "SHAPE_FILL"
          ],
          "hidden": false
        }
      }
    },
    "cta-active": {
      "$value": "{color.electric.700}",
      "$description": "Main campaign button, pressed",
      "$extensions": {
        "dkb.figma": {
          "scopes": [
            "FRAME_FILL",
            "SHAPE_FILL"
          ],
          "hidden": false
        }
      }
    },
    "text-on-cta": {
      "$value": "{color.white}",
      "$description": "Label and icon on campaign.cta",
      "$extensions": {
        "dkb.figma": {
          "scopes": [
            "TEXT_FILL",
            "SHAPE_FILL",
            "STROKE_COLOR"
          ],
          "hidden": false
        }
      }
    },
    "ring": {
      "$value": "{color.cyan.400}",
      "$description": "Keyboard focus ring on the campaign surface (ring.default is invisible on navy)",
      "$extensions": {
        "dkb.figma": {
          "scopes": [
            "EFFECT_COLOR",
            "STROKE_COLOR"
          ],
          "hidden": false
        }
      }
    },
    "accent-1": {
      "$value": "{color.cyan.400}",
      "$description": "Decorative only: ornaments, separators, illustration strokes (cyan). Never text",
      "$extensions": {
        "dkb.figma": {
          "scopes": [
            "FRAME_FILL",
            "SHAPE_FILL",
            "STROKE_COLOR"
          ],
          "hidden": false
        }
      }
    },
    "accent-2": {
      "$value": "{color.electric.600}",
      "$description": "Decorative only: illustration strokes, column rules (electric blue)",
      "$extensions": {
        "dkb.figma": {
          "scopes": [
            "FRAME_FILL",
            "SHAPE_FILL",
            "STROKE_COLOR"
          ],
          "hidden": false
        }
      }
    },
    "accent-3": {
      "$value": "{color.violet.500}",
      "$description": "Decorative only: illustration strokes (violet)",
      "$extensions": {
        "dkb.figma": {
          "scopes": [
            "FRAME_FILL",
            "SHAPE_FILL",
            "STROKE_COLOR"
          ],
          "hidden": false
        }
      }
    },
    "accent-4": {
      "$value": "{color.amber.400}",
      "$description": "Decorative only: illustration strokes (amber)",
      "$extensions": {
        "dkb.figma": {
          "scopes": [
            "FRAME_FILL",
            "SHAPE_FILL",
            "STROKE_COLOR"
          ],
          "hidden": false
        }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "$extensions": {
      "dkb.figma": {
        "scopes": [
          "CORNER_RADIUS"
        ],
        "hidden": false
      }
    },
    "control": {
      "$value": "{radius.md}",
      "$description": "Buttons, inputs, selects"
    },
    "card": {
      "$value": "{radius.lg}"
    },
    "dialog": {
      "$value": "{radius.xl}"
    },
    "badge": {
      "$value": "{radius.full}"
    }
  },
  "border-width": {
    "$type": "dimension",
    "$extensions": {
      "dkb.figma": {
        "scopes": [
          "STROKE_FLOAT"
        ],
        "hidden": false
      }
    },
    "default": {
      "$value": "{border-width.1}"
    },
    "focus": {
      "$value": "{border-width.3}",
      "$description": "Focus ring width. Bound to the spread of shadow.focus-ring and shadow.focus-ring-destructive"
    }
  },
  "width": {
    "$type": "dimension",
    "$description": "Overlay widths, matching shadcn (DS-31). All are MAX widths (DS-40): the overlay is never wider than the viewport minus 2 x space.16 (shadcn max-w-[calc(100%-2rem)]). Below 1024 px dialog and sheet become a drawer (DS-32).",
    "$extensions": {
      "dkb.figma": {
        "scopes": [
          "WIDTH_HEIGHT"
        ],
        "hidden": false
      }
    },
    "hover-card": {
      "$value": "{size.256}",
      "$description": "Max width. shadcn HoverCard w-64. Desktop only (needs hover)"
    },
    "popover": {
      "$value": "{size.288}",
      "$description": "Max width. shadcn Popover w-72; never wider than viewport - 32"
    },
    "sheet": {
      "$value": "{size.384}",
      "$description": "Max width. shadcn Sheet w-3/4 sm:max-w-sm; never wider than viewport - 32"
    },
    "dialog": {
      "$value": "{size.512}",
      "$description": "Max width. shadcn Dialog / AlertDialog max-w-[calc(100%-2rem)] sm:max-w-lg"
    }
  },
  "ring": {
    "$type": "color",
    "$extensions": {
      "dkb.figma": {
        "scopes": [
          "EFFECT_COLOR"
        ],
        "hidden": false
      }
    },
    "$description": "Focus ring colours, drawn as a 3 px spread shadow outside the control (shadcn ring-[3px]).",
    "default": {
      "$value": "{color.alpha.neutral-400-50}",
      "$description": "shadcn ring-ring/50: keyboard focus on any control"
    },
    "destructive": {
      "$value": "{color.alpha.red-600-20}",
      "$description": "Supplementary only (shadcn aria-invalid:ring-destructive/20): border.destructive (3:1) marks the error; this ring never stands alone"
    }
  },
  "icon": {
    "size": {
      "$type": "dimension",
      "$extensions": {
        "dkb.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "hidden": false
        }
      },
      "sm": {
        "$value": "{size.16}"
      },
      "md": {
        "$value": "{size.20}",
        "$description": "Default icon size"
      },
      "lg": {
        "$value": "{size.24}"
      }
    }
  },
  "opacity": {
    "$type": "number",
    "$extensions": {
      "dkb.figma": {
        "scopes": [
          "OPACITY"
        ],
        "hidden": false
      }
    },
    "disabled": {
      "$value": "{opacity.50}",
      "$description": "Disabled selection controls (checkbox, radio, switch): the normal look at 50% (shadcn disabled:opacity-50)"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$extensions": {
        "dkb.figma": {
          "scopes": [],
          "hidden": true
        }
      },
      "sans": {
        "$value": "{font.family.digikala}"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "$extensions": {
      "dkb.figma": {
        "as": "effect-style"
      }
    },
    "card": {
      "$value": "{shadow.sm}"
    },
    "dropdown": {
      "$value": "{shadow.md}"
    },
    "sticky": {
      "$value": "{shadow.lg}",
      "$description": "Elevated elements at the top or side that cast a shadow downward: sticky header, sticky bill box. Same value as shadow.dialog (shadcn shadow-lg); a separate role so either can change alone"
    },
    "sticky-bottom": {
      "$value": [
        {
          "color": "{color.black-alpha.10}",
          "offsetX": "0px",
          "offsetY": "-10px",
          "blur": "15px",
          "spread": "-3px"
        },
        {
          "color": "{color.black-alpha.10}",
          "offsetX": "0px",
          "offsetY": "-4px",
          "blur": "6px",
          "spread": "-4px"
        }
      ],
      "$description": "Bars fixed to the bottom of the screen (action-bar): shadow.lg cast upward (DS-42)"
    },
    "dialog": {
      "$value": "{shadow.lg}",
      "$description": "Dialog, sheet, drawer, toast (shadcn shadow-lg, DS-30)"
    },
    "focus-ring": {
      "$value": [
        {
          "color": "{ring.default}",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "{border-width.focus}"
        }
      ],
      "$description": "Keyboard focus ring (shadcn focus-visible:ring-[3px] ring-ring/50)"
    },
    "focus-ring-destructive": {
      "$value": [
        {
          "color": "{ring.destructive}",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "{border-width.focus}"
        }
      ],
      "$description": "Ring on a field in error (shadcn aria-invalid:ring-destructive/20)"
    }
  },
  "motion": {
    "$extensions": {
      "dkb.figma": {
        "skip": true
      }
    },
    "$description": "Code only (Figma variables can't drive transitions).",
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "100ms"
      },
      "normal": {
        "$value": "200ms"
      },
      "slow": {
        "$value": "300ms"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      },
      "enter": {
        "$value": [
          0,
          0,
          0.2,
          1
        ]
      },
      "exit": {
        "$value": [
          0.4,
          0,
          1,
          1
        ]
      }
    }
  },
  "z-index": {
    "$type": "number",
    "$extensions": {
      "dkb.figma": {
        "skip": true
      }
    },
    "$description": "Code only. Popover layers (menus, popovers, hover cards, combobox lists) sit above dialogs so they work inside them (DS-29).",
    "base": {
      "$value": 0
    },
    "sticky": {
      "$value": 1100
    },
    "overlay": {
      "$value": 1300
    },
    "dialog": {
      "$value": 1400
    },
    "popover": {
      "$value": 1500
    },
    "toast": {
      "$value": 1600
    },
    "tooltip": {
      "$value": 1700
    }
  }
}
